  "declared_dirs": [
    {
      "dir": "assets/canon",
      "summary": "Locked reference images plus `CANON.md`. Source of truth for how things look.",
      "why": "every generation is checked against canon"
    },
    {
      "dir": "assets/references",
      "summary": "Outside reference material: mood, style, real-world photos.",
      "why": "inspiration is kept apart from canon"
    },
    {
      "dir": "assets/characters",
      "summary": "Character sheets: identity, proportions, wardrobe.",
      "why": "characters are built once and reused per shot"
    },
    {
      "dir": "assets/generated",
      "summary": "New candidates straight from a generator. Not approved.",
      "why": "unreviewed output never mixes with approved work"
    },
    {
      "dir": "assets/approved",
      "summary": "Candidates the owner approved. Move files here only on approval.",
      "why": "approval is explicit"
    },
    {
      "dir": "storyboards",
      "summary": "Storyboard panels and sequence files.",
      "why": "framing and story intent"
    },
    {
      "dir": "prompts",
      "summary": "Prompts, saved with the references each one used.",
      "why": "results can be reproduced"
    },
    {
      "dir": "footage/raw",
      "summary": "Original camera or source footage. Read-only.",
      "why": "originals are never altered"
    },
    {
      "dir": "footage/proxies",
      "summary": "Small working copies of raw footage. Rebuildable.",
      "why": "edits stay fast"
    },
    {
      "dir": "audio",
      "summary": "Music, voice and sound sources.",
      "why": "sound is tracked with the picture"
    },
    {
      "dir": "renders",
      "summary": "Render and generation output in progress. Disposable.",
      "why": "work in progress is rebuildable"
    },
    {
      "dir": "review",
      "summary": "Review sheets and side-by-side comparisons awaiting a decision.",
      "why": "one place for pending decisions"
    },
    {
      "dir": "deliverables",
      "summary": "Finished packages, one folder each (`<Title>-rNN`). Never edited after delivery.",
      "why": "delivered work stays reproducible"
    },
    {
      "dir": "manifests",
      "summary": "Lists of what each deliverable contains and which revision.",
      "why": "page and shot numbers resolve to exact files"
    },
    {
      "dir": "archive",
      "summary": "Retired versions. Never use as a source or reference.",
      "why": "rejected work must not leak back in"
    },
    {
      "dir": "docs",
      "summary": "Notes and decisions.",
      "why": "context survives between sessions"
    },
    {
      "dir": "tools",
      "summary": "Project scripts.",
      "why": "pipeline code is not mixed with media"
    }
  ],
  "placement_rules": [
    {
      "kind": "images",
      "match_ext": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "dest_dir": "assets/generated",
      "lfs": true,
      "reason": "unreviewed generator output, approved by moving it out"
    },
    {
      "kind": "video",
      "match_ext": [
        ".mp4",
        ".mov",
        ".webm",
        ".mkv"
      ],
      "dest_dir": "renders",
      "lfs": true,
      "reason": "declared by the video-production kit"
    },
    {
      "kind": "audio",
      "match_ext": [
        ".wav",
        ".mp3",
        ".flac",
        ".ogg"
      ],
      "dest_dir": "audio",
      "lfs": true,
      "reason": "declared by the video-production kit"
    }
  ]
